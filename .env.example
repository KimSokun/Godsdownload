# ==============================================================================
# Godsdownload Environment Configuration Template
# ==============================================================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_ExampleToken

# Telegram Bot Owner (Exclusive access to /setvip command)
OWNER_USERNAME=@your_owner_username
OWNER_ID=

# Telegram Usernames of Bot Administrators (comma-separated, e.g. @your_username,jinwook)
# Both with '@' or without '@' are supported. You can also use numeric IDs if preferred.
ADMIN_USERNAMES=@your_username
ADMIN_IDS=

# USDT TRON (TRC-20) Wallet Address for VIP Payments
USDT_TRON_ADDRESS=TYDzsYUE28mYn7r7ngu7194f4a3821g846

# VIP Subscription Price in USD/USDT per month (Default: 2.0)
VIP_PRICE_USD=2.0

# Free Daily Download Limit per user (Default: 10)
FREE_DOWNLOAD_LIMIT=10

# Automatic Package & yt-dlp Upgrade Interval in Hours (Default: 6)
AUTO_UPDATE_INTERVAL_HOURS=6

# Optional: Local Telegram Bot API Server URL (Allows direct in-app video uploads up to 2000 MB / 1.5 GB!)
# Leave empty to use Telegram Cloud (50 MB limit)
# TELEGRAM_API_URL=http://127.0.0.1:8081/bot
# TELEGRAM_DIRECT_LIMIT_MB=2000

# Optional Cobalt API Mirror URL (Default: https://api.cobalt.tools)
COBALT_API_URL=https://api.cobalt.tools

# Optional Cookies File Path (Default: cookies.txt)
COOKIES_FILE=cookies.txt

# Optional Douyin Cookie & Open-Source Microservice API (for high-speed Douyin China extraction)
DOUYIN_COOKIE=
DOUYIN_API_URL=

# Optional Proxy URL (e.g. socks5://127.0.0.1:1080 or http://user:pass@host:port)
PROXY_URL=
